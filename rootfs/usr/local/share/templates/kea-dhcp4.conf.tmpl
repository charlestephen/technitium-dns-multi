{
  "Dhcp4": {
    "interfaces-config": { "interfaces": [ "${KEA_INTERFACE}" ] },
    "control-socket": { "socket-type": "unix", "socket-name": "/run/kea/kea4-ctrl-socket" },
    "lease-database": { "type": "memfile", "persist": true, "name": "/var/lib/kea/kea-leases4.csv", "lfc-interval": 3600 },
    "valid-lifetime": ${KEA_LEASE_SECONDS},
    "multi-threading": { "enable-multi-threading": false },
    "hooks-libraries": [
      { "library": "${KEA_HOOKS_DIR}/libdhcp_lease_cmds.so" },
      {
        "library": "${KEA_HOOKS_DIR}/libdhcp_ha.so",
        "parameters": {
          "high-availability": [ {
            "this-server-name": "${KEA_HA_THIS_NAME}",
            "mode": "load-balancing",
            "heartbeat-delay": 10000,
            "max-response-delay": 60000,
            "max-ack-delay": 5000,
            "max-unacked-clients": 5,
            "multi-threading": { "enable-multi-threading": false },
            "peers": [
              { "name": "dhcp-primary",   "url": "http://${KEA_HA_PRIMARY_ADDR}:${KEA_CTRL_PORT}/",   "role": "primary" },
              { "name": "dhcp-secondary", "url": "http://${KEA_HA_SECONDARY_ADDR}:${KEA_CTRL_PORT}/", "role": "secondary" }
            ]
          } ]
        }
      }
    ],
    "subnet4": [ {
      "id": 1,
      "subnet": "${KEA_SUBNET}",
      "pools": [ { "pool": "${KEA_POOL}" } ],
      "option-data": [
        { "name": "routers", "data": "${KEA_ROUTERS}" },
        { "name": "domain-name-servers", "data": "${KEA_DNS_SERVERS}" },
        { "name": "domain-name", "data": "${KEA_DOMAIN}" }
      ]
    } ],
    "loggers": [ { "name": "kea-dhcp4", "output_options": [ { "output": "stdout" } ], "severity": "INFO" } ]
  }
}
