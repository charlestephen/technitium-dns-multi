{
  "Control-agent": {
    "http-host": "${KEA_CTRL_BIND}",
    "http-port": ${KEA_CTRL_PORT},
    "control-sockets": {
      "dhcp4": { "socket-type": "unix", "socket-name": "/run/kea/kea4-ctrl-socket" }
    },
    "loggers": [ { "name": "kea-ctrl-agent", "output_options": [ { "output": "stdout" } ], "severity": "INFO" } ]
  }
}
